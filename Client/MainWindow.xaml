<Window x:Class="Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление бюджетом НИИ — Вход"
        Height="450" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        FontFamily="Times New Roman" FontSize="14">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Сетевое программное средство управления бюджетом"
                   TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="и анализа исполнения сметы в научно-исследовательском институте"
                   TextWrapping="Wrap" FontSize="13" Foreground="#444"
                   HorizontalAlignment="Center" Margin="0,0,0,24"/>

        <TextBlock Grid.Row="2" Text="Логин" Margin="0,0,0,4"/>
        <TextBox Grid.Row="3" Height="30" Padding="6"
                 Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="4" Text="Пароль" Margin="0,12,0,4"/>
        <PasswordBox Grid.Row="5" x:Name="PasswordInput" Height="30" Padding="6"
                     PasswordChanged="PasswordInput_PasswordChanged"/>

        <Button Grid.Row="6" Content="Войти" Height="36" Margin="0,20,0,0"
                IsDefault="True"
                Command="{Binding LoginCommand}"/>

        <TextBlock Grid.Row="7" Text="{Binding ErrorMessage}"
                   Foreground="DarkRed" TextWrapping="Wrap"
                   VerticalAlignment="Bottom" Margin="0,12,0,0"/>
    </Grid>
</Window>
