<Window x:Class="Client.Views.MainShell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Client.Views"
        xmlns:accountant="clr-namespace:Client.Views.Accountant"
        xmlns:admin="clr-namespace:Client.Views.Admin"
        xmlns:director="clr-namespace:Client.Views.Director"
        xmlns:economist="clr-namespace:Client.Views.Economist"
        xmlns:head="clr-namespace:Client.Views.Head"
        Title="Управление бюджетом НИИ"
        Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        FontFamily="Times New Roman" FontSize="14">
    <Window.Resources>
        <DataTemplate DataType="{x:Type views:PlaceholderViewModel}"><views:PlaceholderView/></DataTemplate>
        <DataTemplate DataType="{x:Type admin:UsersViewModel}"><admin:UsersView/></DataTemplate>
        <DataTemplate DataType="{x:Type admin:DepartmentsViewModel}"><admin:DepartmentsView/></DataTemplate>
        <DataTemplate DataType="{x:Type admin:ProjectsViewModel}"><admin:ProjectsView/></DataTemplate>
        <DataTemplate DataType="{x:Type admin:CatalogViewModel}"><admin:CatalogView/></DataTemplate>
        <DataTemplate DataType="{x:Type admin:LogsViewModel}"><admin:LogsView/></DataTemplate>
        <DataTemplate DataType="{x:Type admin:BackupViewModel}"><admin:BackupView/></DataTemplate>
        <DataTemplate DataType="{x:Type admin:SettingsViewModel}"><admin:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type economist:SmetasViewModel}"><economist:SmetasView/></DataTemplate>
        <DataTemplate DataType="{x:Type economist:LimitsViewModel}"><economist:LimitsView/></DataTemplate>
        <DataTemplate DataType="{x:Type economist:AnalysisViewModel}"><economist:AnalysisView/></DataTemplate>
        <DataTemplate DataType="{x:Type economist:RequestsReviewViewModel}"><economist:RequestsReviewView/></DataTemplate>
        <DataTemplate DataType="{x:Type economist:ReportsViewModel}"><economist:ReportsView/></DataTemplate>
        <DataTemplate DataType="{x:Type director:OverviewViewModel}"><director:OverviewView/></DataTemplate>
        <DataTemplate DataType="{x:Type director:SmetaApprovalViewModel}"><director:SmetaApprovalView/></DataTemplate>
        <DataTemplate DataType="{x:Type director:ReportsApprovalViewModel}"><director:ReportsApprovalView/></DataTemplate>
        <DataTemplate DataType="{x:Type director:DecisionsViewModel}"><director:DecisionsView/></DataTemplate>
        <DataTemplate DataType="{x:Type head:HeadSmetasViewModel}"><head:HeadSmetasView/></DataTemplate>
        <DataTemplate DataType="{x:Type head:HeadExpensesViewModel}"><head:HeadExpensesView/></DataTemplate>
        <DataTemplate DataType="{x:Type head:HeadRequestsViewModel}"><head:HeadRequestsView/></DataTemplate>
        <DataTemplate DataType="{x:Type head:HeadReportsViewModel}"><head:HeadReportsView/></DataTemplate>
        <DataTemplate DataType="{x:Type accountant:ExpensesViewModel}"><accountant:ExpensesView/></DataTemplate>
        <DataTemplate DataType="{x:Type accountant:PeriodsViewModel}"><accountant:PeriodsView/></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1F3B57" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Управление бюджетом научно-исследовательского института"
                           Foreground="White" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding Header}" Foreground="#E0E0E0"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="Выйти" Command="{Binding LogoutCommand}" Padding="12,4"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#EEF2F7" BorderBrush="#CCD6E0" BorderThickness="0,0,1,0">
                <ListBox ItemsSource="{Binding MenuItems}"
                         SelectedItem="{Binding SelectedEntry}"
                         BorderThickness="0" Background="Transparent"
                         Padding="8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6,8">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                           FontSize="11" Foreground="#555" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="0"/>
        </Grid>
    </Grid>
</Window>
