<UserControl x:Class="Client.Views.Head.HeadSmetasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Times New Roman" FontSize="14">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Сметы отдела" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <Button Content="Обновить" Command="{Binding LoadCommand}" Padding="12,6"/>
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#CCD6E0" BorderThickness="1" Margin="0,0,4,0">
                <DataGrid ItemsSource="{Binding Smetas}" SelectedItem="{Binding SelectedSmeta}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"        Binding="{Binding Id}"          Width="50"/>
                        <DataGridTextColumn Header="Проект"    Binding="{Binding ProjectCode}" Width="130"/>
                        <DataGridTextColumn Header="Форма"     Binding="{Binding FormCode}"    Width="130"/>
                        <DataGridTextColumn Header="Год"       Binding="{Binding Year}"        Width="60"/>
                        <DataGridTextColumn Header="Статус"    Binding="{Binding Status}"      Width="130"/>
                        <DataGridTextColumn Header="План, BYN" Binding="{Binding TotalPlan, StringFormat=N2}" Width="120"/>
                        <DataGridTextColumn Header="Факт, BYN" Binding="{Binding TotalFact, StringFormat=N2}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" BorderBrush="#CCD6E0" BorderThickness="1" Margin="4,0,0,0">
                <DataGrid ItemsSource="{Binding Items}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Статья"      Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="КОСГУ"       Binding="{Binding KosguCode}" Width="70"/>
                        <DataGridTextColumn Header="План, BYN"   Binding="{Binding PlanAmount, StringFormat=N2}" Width="110"/>
                        <DataGridTextColumn Header="Лимит, BYN"  Binding="{Binding LimitAmount, StringFormat=N2}" Width="110"/>
                        <DataGridTextColumn Header="Факт, BYN"   Binding="{Binding FactAmount, StringFormat=N2}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="#555" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
