<UserControl x:Class="Client.Views.Head.HeadReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Times New Roman" FontSize="14">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Утверждённые аналитические отчёты"
                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1">
            <WrapPanel Margin="0,0,0,8">
                <Button Content="Обновить"    Command="{Binding LoadCommand}"     Padding="12,6" Margin="0,0,8,4"/>
                <Button Content="Скачать CSV" Command="{Binding DownloadCommand}" Padding="12,6"/>
            </WrapPanel>

            <DataGrid ItemsSource="{Binding Reports}"
                      SelectedItem="{Binding SelectedReport}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                      BorderBrush="#CCD6E0" BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"     Binding="{Binding Id}"           Width="50"/>
                    <DataGridTextColumn Header="Смета"  Binding="{Binding SmetaId}"      Width="70"/>
                    <DataGridTextColumn Header="Форма"  Binding="{Binding SmetaFormCode}" Width="130"/>
                    <DataGridTextColumn Header="Год"    Binding="{Binding SmetaYear}"    Width="70"/>
                    <DataGridTextColumn Header="Создан" Binding="{Binding CreatedAt, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="150"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}"       Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="#555" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
