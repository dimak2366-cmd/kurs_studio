<Window x:Class="Client.Views.Head.CreateRequestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подача заявки" Height="440" Width="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Times New Roman" FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Новая заявка на расход" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Проект"/>
            <ComboBox x:Name="ProjectCombo" Height="28" Margin="0,0,0,8"
                      DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectionChanged="ProjectCombo_SelectionChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Статья расходов"/>
            <ComboBox x:Name="ItemCombo" Height="28" Margin="0,0,0,8"
                      DisplayMemberPath="Name" SelectedValuePath="Id"/>
        </StackPanel>

        <StackPanel Grid.Row="3">
            <TextBlock Text="Сумма, BYN"/>
            <TextBox x:Name="AmountBox" Height="28" Padding="4" Margin="0,0,0,8"/>
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock Text="Комментарий"/>
            <TextBox x:Name="CommentBox" Height="60" Padding="4" Margin="0,0,0,8"
                     TextWrapping="Wrap" AcceptsReturn="True"/>
        </StackPanel>

        <TextBlock Grid.Row="5" x:Name="ErrorText" Foreground="DarkRed" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="6" x:Name="StatusText" Foreground="#555" Margin="0,4,0,0"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Отмена" IsCancel="True" Padding="16,4" Margin="0,0,8,0"/>
            <Button Content="Подать заявку" Click="Save_Click" Padding="16,4" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
