<UserControl x:Class="Client.Views.Head.HeadExpensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Times New Roman" FontSize="14">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Фактические расходы отдела"
                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1">
            <WrapPanel Margin="0,0,0,8">
                <Button Content="Обновить" Command="{Binding LoadCommand}" Padding="12,6" Margin="0,0,8,4"/>
                <TextBlock Text="Статус:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding FilterStatus}"
                          Width="180" Height="26" Margin="0,0,8,4"/>
            </WrapPanel>

            <DataGrid ItemsSource="{Binding Expenses}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                      BorderBrush="#CCD6E0" BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"         Binding="{Binding Id}"           Width="50"/>
                    <DataGridTextColumn Header="Проект"     Binding="{Binding ProjectCode}"  Width="130"/>
                    <DataGridTextColumn Header="Статья"     Binding="{Binding ExpenseItemName}" Width="*"/>
                    <DataGridTextColumn Header="КОСГУ"      Binding="{Binding KosguCode}"    Width="70"/>
                    <DataGridTextColumn Header="Дата"       Binding="{Binding Date, StringFormat=\{0:yyyy-MM-dd\}}" Width="100"/>
                    <DataGridTextColumn Header="Сумма, BYN" Binding="{Binding Amount, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="Документ"   Binding="{Binding DocumentType}" Width="140"/>
                    <DataGridTextColumn Header="№"          Binding="{Binding DocumentNumber}" Width="120"/>
                    <DataGridTextColumn Header="Статус"     Binding="{Binding Status}"       Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="#555" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
