<UserControl x:Class="Client.Views.Director.DecisionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Times New Roman" FontSize="14">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Управленческие решения"
                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Background="#F5F8FC" BorderBrush="#CCD6E0" BorderThickness="1" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Новое решение" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Смета:" Margin="0,0,0,4"/>
                    <ComboBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Smetas}" SelectedItem="{Binding SelectedSmetaForItems}"
                              DisplayMemberPath="ProjectCode" Height="28" Margin="0,0,8,0"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="Загрузить статьи" Command="{Binding LoadItemsCommand}"
                            Padding="12,4" Margin="8,0,0,0"/>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Статья:" Margin="8,0,0,4"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                              DisplayMemberPath="Name" Height="28" Margin="8,0,0,0"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Период:" Margin="0,8,0,4"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}"
                              Height="28" Margin="8,8,0,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding Year}"/>
                                    <Run Text="/"/>
                                    <Run Text="{Binding Month}"/>
                                    <Run Text=" (закрыт: "/>
                                    <Run Text="{Binding IsClosed}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <TextBlock Text="Текст решения:" Margin="0,8,0,4"/>
                <TextBox Text="{Binding NewDecisionText, UpdateSourceTrigger=PropertyChanged}"
                         Height="60" AcceptsReturn="True" TextWrapping="Wrap" Padding="4"
                         VerticalScrollBarVisibility="Auto"/>

                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Зарегистрировать решение" Command="{Binding CreateCommand}"
                            Padding="16,6" FontWeight="SemiBold"/>
                    <Button Content="Обновить список" Command="{Binding LoadAllCommand}"
                            Padding="12,6" Margin="8,0,0,0"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Decisions}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                  BorderBrush="#CCD6E0" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"         Binding="{Binding Id}"           Width="50"/>
                <DataGridTextColumn Header="Статья"     Binding="{Binding ExpenseItemName}" Width="*"/>
                <DataGridTextColumn Header="КОСГУ"      Binding="{Binding KosguCode}"    Width="70"/>
                <DataGridTextColumn Header="Период"     Binding="{Binding PeriodYear}"  Width="80"/>
                <DataGridTextColumn Header="Решение"    Binding="{Binding Decision}"    Width="*"/>
                <DataGridTextColumn Header="Создано"    Binding="{Binding CreatedAt, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="#555" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
