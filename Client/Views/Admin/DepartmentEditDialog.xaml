<Window x:Class="Client.Views.Admin.DepartmentEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отдел" Height="200" Width="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Times New Roman" FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText" Text="Отдел" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1" Text="Наименование"/>
        <TextBox Grid.Row="2" x:Name="NameBox" Height="28" Padding="4" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="3" x:Name="ErrorText" Foreground="DarkRed" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Отмена" IsCancel="True" Padding="16,4" Margin="0,0,8,0"/>
            <Button Content="Сохранить" Click="Save_Click" Padding="16,4" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
