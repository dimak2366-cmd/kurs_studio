<UserControl x:Class="Client.Views.Admin.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Times New Roman" FontSize="14">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Настройки сервера"
                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <Button Content="Обновить"     Command="{Binding LoadCommand}"   Padding="12,6" Margin="0,0,8,4"/>
            <Button Content="Сохранить"    Command="{Binding SaveCommand}"   Padding="12,6" Margin="0,0,8,4" FontWeight="SemiBold"/>
            <Button Content="Сбросить"     Command="{Binding ResetCommand}"  Padding="12,6" Margin="0,0,8,4"/>
        </WrapPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Адрес сервера:" Margin="0,6,8,6"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Address}" FontWeight="SemiBold" Margin="0,6"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Порт:" Margin="0,6,8,6"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Port}" FontWeight="SemiBold" Margin="0,6"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Максимум попыток входа:" Margin="0,6,8,6"/>
                <TextBox Grid.Row="2" Grid.Column="1" Width="120" HorizontalAlignment="Left" Height="26" Padding="4"
                         Text="{Binding MaxFailedAttempts, UpdateSourceTrigger=PropertyChanged}" Margin="0,6"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Блокировка, минут:" Margin="0,6,8,6"/>
                <TextBox Grid.Row="3" Grid.Column="1" Width="120" HorizontalAlignment="Left" Height="26" Padding="4"
                         Text="{Binding LockoutMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="0,6"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Таймаут сессии, минут:" Margin="0,6,8,6"/>
                <TextBox Grid.Row="4" Grid.Column="1" Width="120" HorizontalAlignment="Left" Height="26" Padding="4"
                         Text="{Binding SessionTimeoutMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="0,6"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Папка резервных копий:" Margin="0,6,8,6"/>
                <TextBox Grid.Row="5" Grid.Column="1" Height="26" Padding="4"
                         Text="{Binding BackupPathEdit, UpdateSourceTrigger=PropertyChanged}" Margin="0,6"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Путь к pg_dump.exe:" Margin="0,6,8,6"/>
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding PgDumpPath}" FontFamily="Consolas" Foreground="#555" Margin="0,6"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Путь к pg_restore.exe:" Margin="0,6,8,6"/>
                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding PgRestorePath}" FontFamily="Consolas" Foreground="#555" Margin="0,6"/>
            </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="#555" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
