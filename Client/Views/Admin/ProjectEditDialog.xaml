<Window x:Class="Client.Views.Admin.ProjectEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проект" Height="480" Width="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Times New Roman" FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText" Text="Новый проект" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Код проекта"/>
            <TextBox x:Name="CodeBox" Height="28" Padding="4" Margin="0,0,0,8"/>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Название"/>
            <TextBox x:Name="NameBox" Height="28" Padding="4" Margin="0,0,0,8"/>
        </StackPanel>

        <StackPanel Grid.Row="3">
            <TextBlock Text="Отдел"/>
            <ComboBox x:Name="DepartmentCombo" Height="28" Margin="0,0,0,8"
                      DisplayMemberPath="Name" SelectedValuePath="Id"/>
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock Text="Дата начала"/>
            <DatePicker x:Name="StartDatePicker" Height="28" Margin="0,0,0,8"/>
        </StackPanel>

        <StackPanel Grid.Row="5">
            <TextBlock Text="Дата окончания"/>
            <DatePicker x:Name="EndDatePicker" Height="28" Margin="0,0,0,8"/>
        </StackPanel>

        <TextBlock Grid.Row="6" x:Name="ErrorText" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,4,0,0"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Отмена" IsCancel="True" Padding="16,4" Margin="0,0,8,0"/>
            <Button Content="Сохранить" Click="Save_Click" Padding="16,4" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
