<UserControl x:Class="Client.Views.Admin.DepartmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Times New Roman" FontSize="14">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Отделы института"
                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1">
            <WrapPanel Margin="0,0,0,8">
                <Button Content="Обновить"       Command="{Binding LoadCommand}"   Padding="12,6" Margin="0,0,8,4"/>
                <Button Content="Добавить"       Command="{Binding AddCommand}"    Padding="12,6" Margin="0,0,8,4"/>
                <Button Content="Редактировать"  Command="{Binding EditCommand}"   Padding="12,6" Margin="0,0,8,4"/>
                <Button Content="Удалить"        Command="{Binding DeleteCommand}" Padding="12,6" Margin="0,0,8,4" Foreground="DarkRed"/>
            </WrapPanel>

            <DataGrid ItemsSource="{Binding Departments}"
                      SelectedItem="{Binding SelectedDepartment}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      BorderBrush="#CCD6E0" BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"            Binding="{Binding Id}"           Width="60"/>
                    <DataGridTextColumn Header="Наименование"  Binding="{Binding Name}"         Width="*"/>
                    <DataGridTextColumn Header="Проектов"      Binding="{Binding ProjectCount}" Width="100"/>
                    <DataGridTextColumn Header="Сотрудников"   Binding="{Binding UserCount}"    Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="#555" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
