<UserControl x:Class="Client.Views.Admin.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Times New Roman" FontSize="14">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Пользователи системы"
                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1">
            <WrapPanel Margin="0,0,0,8">
                <Button Content="Обновить"     Command="{Binding LoadCommand}"          Padding="12,6" Margin="0,0,8,4"/>
                <Button Content="Добавить"     Command="{Binding AddCommand}"           Padding="12,6" Margin="0,0,8,4"/>
                <Button Content="Редактировать" Command="{Binding EditCommand}"         Padding="12,6" Margin="0,0,8,4"/>
                <Button Content="Заблокировать" Command="{Binding BlockCommand}"        Padding="12,6" Margin="0,0,8,4"/>
                <Button Content="Разблокировать" Command="{Binding UnblockCommand}"     Padding="12,6" Margin="0,0,8,4"/>
                <Button Content="Сбросить пароль" Command="{Binding ResetPasswordCommand}" Padding="12,6" Margin="0,0,8,4"/>
                <Button Content="Удалить"      Command="{Binding DeleteCommand}"        Padding="12,6" Margin="0,0,8,4" Foreground="DarkRed"/>
            </WrapPanel>

            <DataGrid ItemsSource="{Binding Users}"
                      SelectedItem="{Binding SelectedUser}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      BorderBrush="#CCD6E0" BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"         Binding="{Binding Id}"          Width="50"/>
                    <DataGridTextColumn Header="Логин"      Binding="{Binding Login}"       Width="140"/>
                    <DataGridTextColumn Header="ФИО"        Binding="{Binding FullName}"    Width="240"/>
                    <DataGridTextColumn Header="Роль"       Binding="{Binding RoleName}"    Width="160"/>
                    <DataGridTextColumn Header="Отдел"      Binding="{Binding DepartmentName}" Width="200"/>
                    <DataGridTextColumn Header="Заблокирован" Binding="{Binding IsBlocked}" Width="110"/>
                    <DataGridTextColumn Header="Попыток входа" Binding="{Binding FailedAttempts}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="#555" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
