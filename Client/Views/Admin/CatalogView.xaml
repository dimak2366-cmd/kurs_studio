<UserControl x:Class="Client.Views.Admin.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Справочник статей расходов (редактируемый)"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="Добавить" Command="{Binding AddCommand}" Width="110" Height="28" Margin="0,0,6,0"/>
            <Button Content="Изменить" Command="{Binding EditCommand}" Width="110" Height="28" Margin="0,0,6,0"/>
            <Button Content="Удалить" Command="{Binding DeleteCommand}" Width="110" Height="28"/>
        </StackPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding CatalogItems}"
                  SelectedItem="{Binding SelectedCatalogItem, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Код КОСГУ" Binding="{Binding KosguCode}" Width="120"/>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="Справочная информация (только для чтения)"
                   FontSize="14" FontWeight="Bold" Margin="0,16,0,8"/>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Роли" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <DataGrid ItemsSource="{Binding Roles}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" Height="160">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Статьи из смет" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <DataGrid ItemsSource="{Binding ExpenseItems}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" Height="160">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="КОСГУ" Binding="{Binding KosguCode}" Width="70"/>
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <StackPanel Grid.Column="4">
                <TextBlock Text="Формы смет" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <DataGrid ItemsSource="{Binding SmetaForms}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" Height="160">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код формы" Binding="{Binding FormCode}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Обновить" Command="{Binding LoadCommand}" Width="120" Height="28"/>
        </StackPanel>

        <TextBlock Grid.Row="6" Text="{Binding StatusMessage}"
                   Foreground="DarkSlateGray" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
