<UserControl x:Class="Client.Views.Admin.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Times New Roman" FontSize="14">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Справочники" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <Button Grid.Row="1" Content="Обновить" Command="{Binding LoadCommand}"
                HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,12"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Роли -->
            <Border Grid.Column="0" BorderBrush="#CCD6E0" BorderThickness="1" Margin="0,0,6,0" Padding="8">
                <StackPanel>
                    <TextBlock Text="Роли пользователей" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <DataGrid ItemsSource="{Binding Roles}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"    Binding="{Binding Id}"   Width="50"/>
                            <DataGridTextColumn Header="Роль"  Binding="{Binding Name}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Статьи расходов -->
            <Border Grid.Column="1" BorderBrush="#CCD6E0" BorderThickness="1" Margin="6,0,6,0" Padding="8">
                <StackPanel>
                    <TextBlock Text="Статьи расходов (КОСГУ)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <DataGrid ItemsSource="{Binding ExpenseItems}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="КОСГУ"      Binding="{Binding KosguCode}" Width="80"/>
                            <DataGridTextColumn Header="Наименование" Binding="{Binding Name}"     Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Формы смет -->
            <Border Grid.Column="2" BorderBrush="#CCD6E0" BorderThickness="1" Margin="6,0,0,0" Padding="8">
                <StackPanel>
                    <TextBlock Text="Формы смет" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <DataGrid ItemsSource="{Binding SmetaForms}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Код формы" Binding="{Binding FormCode}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="#555" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
