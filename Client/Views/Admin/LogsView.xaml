<UserControl x:Class="Client.Views.Admin.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Times New Roman" FontSize="14">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Журналы системы" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <Button Grid.Row="1" Content="Обновить всё" Command="{Binding LoadAllCommand}"
                HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,12"/>

        <TabControl Grid.Row="2">
            <TabItem Header="Журнал действий">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Сущность:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding AuditEntityFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Width="120" Height="26" Margin="0,0,12,0" Padding="4"/>
                        <TextBlock Text="Действие:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding AuditActionFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Width="120" Height="26" Margin="0,0,12,0" Padding="4"/>
                        <Button Content="Применить фильтр" Command="{Binding LoadAuditCommand}" Padding="12,4"/>
                    </WrapPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding AuditLogs}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"        Binding="{Binding Id}"        Width="60"/>
                            <DataGridTextColumn Header="Время"     Binding="{Binding Timestamp, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="160"/>
                            <DataGridTextColumn Header="Польз."    Binding="{Binding UserLogin}" Width="100"/>
                            <DataGridTextColumn Header="Действие"  Binding="{Binding Action}"    Width="120"/>
                            <DataGridTextColumn Header="Сущность"  Binding="{Binding Entity}"    Width="120"/>
                            <DataGridTextColumn Header="ID сущ."   Binding="{Binding EntityId}"  Width="70"/>
                            <DataGridTextColumn Header="Детали"    Binding="{Binding Details}"   Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Журнал ошибок">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Уровень:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox SelectedValue="{Binding ErrorLevelFilter, UpdateSourceTrigger=PropertyChanged}"
                                  Width="140" Height="26" Margin="0,0,12,0">
                            <ComboBoxItem Content=""/>
                            <ComboBoxItem Content="Error"/>
                            <ComboBoxItem Content="Warning"/>
                            <ComboBoxItem Content="Info"/>
                        </ComboBox>
                        <Button Content="Применить фильтр" Command="{Binding LoadErrorsCommand}" Padding="12,4"/>
                    </WrapPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ErrorLogs}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"    Binding="{Binding Id}"        Width="60"/>
                            <DataGridTextColumn Header="Время" Binding="{Binding Timestamp, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="160"/>
                            <DataGridTextColumn Header="Уровень" Binding="{Binding Level}"   Width="80"/>
                            <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="#555" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
