<UserControl x:Class="Client.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Times New Roman" FontSize="14">
    <Border Padding="24">
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#333"/>
            <Border BorderBrush="#888" BorderThickness="1" Padding="16" Margin="0,24,0,0" Background="#F8F8F8">
                <TextBlock TextWrapping="Wrap">
                    Экран будет реализован на следующем этапе. Здесь появятся таблицы,
                    фильтры и операции, соответствующие выбранному пункту меню.
                </TextBlock>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
