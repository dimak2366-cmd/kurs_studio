<UserControl x:Class="Client.Views.Accountant.PeriodsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Times New Roman" FontSize="14">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Отчётные периоды"
                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1">
            <WrapPanel Margin="0,0,0,8">
                <Button Content="Обновить"       Command="{Binding LoadCommand}"  Padding="12,6" Margin="0,0,8,4"/>
                <Button Content="Закрыть период" Command="{Binding CloseCommand}" Padding="12,6" Margin="0,0,8,4" FontWeight="SemiBold" Foreground="DarkRed"/>
            </WrapPanel>

            <DataGrid ItemsSource="{Binding Periods}"
                      SelectedItem="{Binding SelectedPeriod}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                      BorderBrush="#CCD6E0" BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"           Binding="{Binding Id}"           Width="50"/>
                    <DataGridTextColumn Header="Год"          Binding="{Binding Year}"         Width="80"/>
                    <DataGridTextColumn Header="Месяц"        Binding="{Binding Month}"        Width="80"/>
                    <DataGridTextColumn Header="Закрыт"       Binding="{Binding IsClosed}"     Width="80"/>
                    <DataGridTextColumn Header="Закрыт (дата)" Binding="{Binding ClosedAt, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="160"/>
                    <DataGridTextColumn Header="Записей"      Binding="{Binding ExpenseCount}" Width="100"/>
                    <DataGridTextColumn Header="Несверенных"  Binding="{Binding UnverifiedCount}" Width="110"/>
                    <DataGridTextColumn Header="Сумма, BYN"   Binding="{Binding TotalAmount, StringFormat=N2}" Width="130"/>
                </DataGrid.Columns>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsClosed}" Value="True">
                                <Setter Property="Background" Value="#ECEFF1"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding UnverifiedCount}" Value="0">
                                <Setter Property="Background" Value="#F1F8E9"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="#555" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
