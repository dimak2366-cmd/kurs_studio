<Window x:Class="Client.Views.Accountant.ActualExpenseEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фактический расход" Height="540" Width="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Times New Roman" FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText" Text="Новый расход" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" x:Name="SmetaPanel">
            <TextBlock Text="Смета"/>
            <ComboBox x:Name="SmetaCombo" Height="28" Margin="0,0,0,8"
                      DisplayMemberPath="ProjectCode" SelectedValuePath="Id"
                      SelectionChanged="SmetaCombo_SelectionChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Статья расходов"/>
            <ComboBox x:Name="ItemCombo" Height="28" Margin="0,0,0,8"
                      DisplayMemberPath="Name" SelectedValuePath="Id"/>
        </StackPanel>

        <StackPanel Grid.Row="3">
            <TextBlock Text="Дата расхода"/>
            <DatePicker x:Name="DatePicker" Height="28" Margin="0,0,0,8"/>
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock Text="Сумма, BYN"/>
            <TextBox x:Name="AmountBox" Height="28" Padding="4" Margin="0,0,0,8"/>
        </StackPanel>

        <StackPanel Grid.Row="5">
            <TextBlock Text="Тип документа"/>
            <ComboBox x:Name="DocTypeCombo" Height="28" Margin="0,0,0,8" IsEditable="True">
                <ComboBoxItem Content="Платёжное поручение"/>
                <ComboBoxItem Content="Кассовый ордер"/>
                <ComboBoxItem Content="Акт выполненных работ"/>
                <ComboBoxItem Content="Товарная накладная"/>
                <ComboBoxItem Content="Авансовый отчёт"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="6">
            <TextBlock Text="Номер документа"/>
            <TextBox x:Name="DocNumberBox" Height="28" Padding="4" Margin="0,0,0,8"/>
        </StackPanel>

        <StackPanel Grid.Row="7">
            <TextBlock Text="Дата документа"/>
            <DatePicker x:Name="DocDatePicker" Height="28" Margin="0,0,0,8"/>
            <TextBlock x:Name="ErrorText" Foreground="DarkRed" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Отмена" IsCancel="True" Padding="16,4" Margin="0,0,8,0"/>
            <Button Content="Сохранить" Click="Save_Click" Padding="16,4" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
