<UserControl x:Class="Client.Views.Economist.SmetasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Times New Roman" FontSize="14">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Сметы проектов"
                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1">
            <WrapPanel Margin="0,0,0,8">
                <Button Content="Обновить"      Command="{Binding LoadCommand}"     Padding="12,6" Margin="0,0,8,4"/>
                <Button Content="Создать смету" Command="{Binding AddCommand}"      Padding="12,6" Margin="0,0,8,4"/>
                <Button Content="Редактировать" Command="{Binding EditCommand}"     Padding="12,6" Margin="0,0,8,4"/>
                <Button Content="Создать изменение" Command="{Binding ChangesCommand}" Padding="12,6" Margin="0,0,8,4" Foreground="DarkBlue"/>
                <TextBlock Text="Проект:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding FilterProject}"
                          DisplayMemberPath="Name" Width="300" Height="26" Margin="0,0,8,4"/>
            </WrapPanel>

            <DataGrid ItemsSource="{Binding Smetas}"
                      SelectedItem="{Binding SelectedSmeta}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      BorderBrush="#CCD6E0" BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"          Binding="{Binding Id}"         Width="50"/>
                    <DataGridTextColumn Header="Проект"      Binding="{Binding ProjectCode}" Width="130"/>
                    <DataGridTextColumn Header="Форма"       Binding="{Binding FormCode}"   Width="110"/>
                    <DataGridTextColumn Header="Год"         Binding="{Binding Year}"       Width="60"/>
                    <DataGridTextColumn Header="Статус"      Binding="{Binding Status}"     Width="130"/>
                    <DataGridTextColumn Header="План, BYN"   Binding="{Binding TotalPlan, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="Лимит, BYN"  Binding="{Binding TotalLimit, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="Факт, BYN"   Binding="{Binding TotalFact, StringFormat=N2}"  Width="120"/>
                    <DataGridTextColumn Header="Создана"     Binding="{Binding CreatedAt, StringFormat=\{0:yyyy-MM-dd\}}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="#555" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
