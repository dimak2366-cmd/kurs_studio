<Window x:Class="Client.Views.Economist.SmetaCreateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новая смета" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Times New Roman" FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Создание новой сметы" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Проект:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" x:Name="ProjectCombo" Height="28"
                      DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,16,0"/>
            <TextBlock Grid.Column="2" Text="Форма:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="3" x:Name="FormCodeBox" Text="2-смета" Width="140" Height="28" Padding="4" Margin="0,0,16,0"/>
            <TextBlock Grid.Column="4" Text="Год:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="5" x:Name="YearBox" Width="80" Height="28" Padding="4"/>
        </Grid>

        <TextBlock Grid.Row="2" Text="Статьи расходов:" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <WrapPanel Grid.Row="3" Margin="0,0,0,6">
            <Button Content="Добавить строку" Click="AddRow_Click" Padding="12,4" Margin="0,0,8,0"/>
            <Button Content="Удалить выбранную" Click="RemoveRow_Click" Padding="12,4"/>
        </WrapPanel>

        <DataGrid Grid.Row="4" x:Name="ItemsGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  GridLinesVisibility="All"
                  BorderBrush="#CCD6E0" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="КОСГУ"         Binding="{Binding KosguCode, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridTextColumn Header="План, BYN"     Binding="{Binding PlanAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" IsReadOnly="True" Width="110"/>
                <DataGridTextColumn Header="Лимит, BYN"    Binding="{Binding LimitAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="110"/>
                <DataGridTextColumn Header="Кол-во"        Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="90"/>
                <DataGridTextColumn Header="Цена, BYN"     Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="5" x:Name="ErrorText" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,6,0,0"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Отмена" IsCancel="True" Padding="16,4" Margin="0,0,8,0"/>
            <Button Content="Создать" Click="Save_Click" Padding="16,4" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
