<Window x:Class="Client.Views.Economist.RejectReasonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Причина отклонения" Height="260" Width="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Times New Roman" FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="PromptText" Text="Укажите причину отклонения:"
                   FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap"/>

        <TextBox Grid.Row="1" x:Name="ReasonBox" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" Padding="4"
                 BorderBrush="#CCD6E0" BorderThickness="1"/>

        <TextBlock Grid.Row="2" x:Name="ErrorText" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Отмена" IsCancel="True" Padding="16,4" Margin="0,0,8,0"/>
            <Button Content="Отклонить" Click="Ok_Click" Padding="16,4" IsDefault="True" Foreground="DarkRed"/>
        </StackPanel>
    </Grid>
</Window>
