<UserControl x:Class="Client.Views.Economist.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Times New Roman" FontSize="14">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Аналитические отчёты"
                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1">
            <WrapPanel Margin="0,0,0,8">
                <Button Content="Обновить" Command="{Binding LoadCommand}" Padding="12,6" Margin="0,0,8,4"/>
                <Button Content="Скачать CSV" Command="{Binding DownloadCommand}" Padding="12,6" Margin="0,0,8,4"/>

                <TextBlock Text="Смета для нового отчёта:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                <ComboBox ItemsSource="{Binding Smetas}" SelectedItem="{Binding SmetaForCreate}"
                          DisplayMemberPath="ProjectCode" Width="260" Height="26" Margin="0,0,8,4"/>
                <Button Content="Создать отчёт" Command="{Binding CreateCommand}" Padding="12,6" Margin="0,0,8,4" FontWeight="SemiBold"/>
            </WrapPanel>

            <DataGrid ItemsSource="{Binding Reports}"
                      SelectedItem="{Binding SelectedReport}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      BorderBrush="#CCD6E0" BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"         Binding="{Binding Id}"           Width="50"/>
                    <DataGridTextColumn Header="Смета"      Binding="{Binding SmetaId}"      Width="70"/>
                    <DataGridTextColumn Header="Форма"      Binding="{Binding SmetaFormCode}" Width="110"/>
                    <DataGridTextColumn Header="Год"        Binding="{Binding SmetaYear}"    Width="70"/>
                    <DataGridTextColumn Header="Автор"      Binding="{Binding CreatedByLogin}" Width="110"/>
                    <DataGridTextColumn Header="Создан"     Binding="{Binding CreatedAt, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="150"/>
                    <DataGridTextColumn Header="Статус"     Binding="{Binding Status}"      Width="140"/>
                    <DataGridTextColumn Header="Размер, симв." Binding="{Binding ContentLength}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="#555" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
